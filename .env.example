NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed for invitations, rate limits and the private storage erasure worker.
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
SESSION_TIMEOUT_MINUTES=30
# Login credentials (username & password)
APP_USER=
APP_PASSWORD=
# Random 32+ character value; used for share-link signatures and hashed rate-limit keys.
APP_SECRET=
# Set only in your scheduler, never in browser code.
CRON_SECRET=
# Optional Sentry-compatible ingest endpoint (no personal data is sent by the app).
ERROR_WEBHOOK_URL=
# For cloud deployment set HTTPS in APP_URL. Supabase region must be ap-south-1.
